{
  "kit": "1.2.0",
  "branch": "main",
  "node": "22",
  "setup": [],
  "gates": [
    { "name": "syntax", "run": "node scripts/check-syntax.mjs" },
    { "name": "film-smoke", "run": "node scripts/film-smoke.mjs" },
    { "name": "film-browser", "run": "node scripts/film-browser.mjs" }
